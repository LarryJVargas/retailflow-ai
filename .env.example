APP_NAME="RetailFlow AI"
APP_ENV="development"
DEBUG=True

# Database Configuration
# - SQLite (Desarrollo local por defecto):
DATABASE_URL="sqlite:///./retailflow.db"
# - PostgreSQL (Supabase Session Pooler / Render para producción):
#   (postgres:// y postgresql:// se normalizan automáticamente a postgresql+psycopg2://)
# DATABASE_URL="postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Google Gemini AI Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# CORS Configuration (orígenes permitidos separados por comas)
# En desarrollo local:
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
# En producción (ejemplo con Vercel):
# CORS_ORIGINS="https://retailflow-ai.vercel.app,http://localhost:5173"

# Rate Limiting Configuration (SlowAPI)
RATE_LIMIT_WRITE="10/minute"
RATE_LIMIT_DELETE="5/minute"
RATE_LIMIT_AI="3/minute"
